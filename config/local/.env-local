# Keep local ports below 49152: WSL2 mirrored networking + Hyper-V/Docker HNS/WinNAT
# re-reserves parts of the Windows ephemeral pool (49152–65535) on each boot.
LOCAL_WORKER_PORT=48210
# Boards start only when KIAO_HYBRIDFLOW_STORE_DATABASE_URL names a database (bin/local-start-kiao.sh).
LOCAL_HYBRIDFLOW_STORE_PORT=48211

# docker-compose-local.yml only; bin/local-start-kiao.sh does not use Docker.
LOCAL_DB_PORT=48233

LOCAL_DASHBOARD_PORT=48302
