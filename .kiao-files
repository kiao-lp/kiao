# .kiao-files excludes paths from automatic DCMS passes here and below.
# Nested rules add exclusions. Ancestor exclusions still apply.
# Use one pattern per line. Blank lines and lines starting with # are ignored.
# After trailing slashes are stripped, a slash anchors the pattern here.
# Slashless patterns match at any depth. A lone / excludes the whole tree.
# * stays within one path segment. Recursive ** and ! negation are unsupported.
# Directory matches include descendants.
#
# Rules before the first section apply to all passes. Each section names one pass.
# [migration] startup file-store migrations
# [refactor]  link updates after a rename or delete
# [search]    search and the scope reported before delete confirmation
#
# Directly targeted folders are still searched and their contents reported before deletion.
# .git and the service state directory are always excluded.

# Independent agentic resource repositories.
agentic-resources

node_modules
bower_components
vendor
build
dist
out
target
coverage
__pycache__

.*

[migration]
# Automatic migrations can silently alter fixture assertions or convert authored
# architecture documents in this source tree.
/

[refactor]
# Preserve fixture paths used in test assertions.
e2e/data

# Only shared rules apply to fixture searches.
