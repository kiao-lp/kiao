    {
      "label": "Employment contract",
      "pattern": "\\b(?:contrat\\s+de\\s+travail|\\bCDI\\b|\\bCDD\\b|avenant\\s+au\\s+contrat|p[ée]riode\\s+d['’]essai|employment\\s+(?:contract|agreement)|offer\\s+letter|promesse\\s+d['’]embauche|convention\\s+collective|clause\\s+de\\s+non[\\s-]concurrence)\\b",
