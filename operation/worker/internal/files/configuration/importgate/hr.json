    },
    {
      "label": "Bonus, equity and incentives",
      "pattern": "\\b(?:bonus|prime\\s+(?:annuelle|exceptionnelle|d['’]objectifs?|de\\s+performance)|int[ée]ressement|participation\\s+aux\\s+b[ée]n[ée]fices|stock[\\s-]?options?|\\bRSUs?\\b|\\bBSPCE\\b|actions\\s+gratuites|equity\\s+grant|commission\\s+de\\s+vente)\\b",
      "criticality": "medium"
    },
    {
      "label": "Performance review",
      "pattern": "\\b(?:entretien\\s+(?:annuel|professionnel|d['’][ée]valuation)|[ée]valuation\\s+(?:annuelle|de\\s+performance)|performance\\s+review|appraisal|360[°\\s]*feedback|calibration\\s+meeting|notation\\s+annuelle|potentiel\\s+d['’][ée]volution|performance\\s+improvement\\s+plan|plan\\s+d['’]am[ée]lioration)\\b"
    },
    {
      "label": "Discipline or dismissal",
      "pattern": "\\b(?:licenciement|rupture\\s+conventionnelle|mise\\s+[àa]\\s+pied|avertissement\\s+disciplinaire|proc[ée]dure\\s+disciplinaire|entretien\\s+pr[ée]alable|faute\\s+(?:grave|lourde)|(?:unfair\\s+|notice\\s+of\\s+|letter\\s+of\\s+)dismissal|termination\\s+letter|severance|gardening\\s+leave|d[ée]mission|pr[ée]avis\\s+de\\s+(?:d[ée]part|licenciement|d[ée]mission))\\b",
      "criticality": "critical"
