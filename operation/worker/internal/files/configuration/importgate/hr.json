    {
      "label": "Absence and leave",
      "pattern": "\\b(?:cong[ée]s?\\s+(?:pay[ée]s|maladie|maternit[ée]|paternit[ée]|parental|sabbatique|sans\\s+solde)|\\bRTT\\b|absent[ée]isme|compteur\\s+de\\s+cong[ée]s|sick\\s+leave|parental\\s+leave)\\b",
      "criticality": "medium"
    },
    {
      "label": "Employee identifier",
      "pattern": "\\b(?:matricule|num[ée]ro\\s+d['’]employ[ée]|employee\\s+(?:id|number)|\\bUID\\s+salari[ée])\\b[ \\t]*[:=#]?[ \\t]*[A-Z0-9-]{3,}\\b",
