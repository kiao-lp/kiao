{
  "category": "hr",
  "label": "Employment, payroll and personnel records",
  "description": "What an employer knows about the people who work for it. Rarely secret in the technical sense and almost always confidential in the contractual one: a payslip, an appraisal or a redundancy plan reaching a shared store is the most common accidental disclosure there is.",
  "criticality": "high",
  "matchers": [
    {
      "label": "Payslip or payroll document",
      "pattern": "\\b(?:bulletin\\s+de\\s+(?:paie|salaire)|fiche\\s+de\\s+paie|payslip|pay\\s+stub|livre\\s+de\\s+paie|journal\\s+de\\s+paie|DSN\\b|net\\s+[àa]\\s+payer|net\\s+imposable|brut\\s+annuel|cotisations?\\s+salariales?)\\b",
      "criticality": "critical"
    },
    {
