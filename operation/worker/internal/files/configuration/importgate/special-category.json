    },
    {
      "label": "Political opinion",
      "pattern": "\\b(?:opinion(?:s)?\\s+politiques?|appartenance\\s+politique|parti\\s+politique|political\\s+(?:opinion|affiliation|party)|encart[ée]e?\\s+(?:au|chez)|vote\\s+(?:exprim[ée]|pour))\\b"
