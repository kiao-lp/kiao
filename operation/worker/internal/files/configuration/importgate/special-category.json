{
  "category": "special-category",
  "label": "Health, beliefs and other special-category data",
  "description": "The data GDPR article 9 forbids processing outright, absent one of its narrow exceptions: health, sex life, biometrics, ethnicity, politics, religion, union membership — and, under article 10, criminal convictions. Consent to hold ordinary personal data is never consent to hold this, which is why it outranks the identity category rather than sitting inside it.",
  "criticality": "critical",
  "matchers": [
    {
      "label": "Medical record or certificate",
      "pattern": "\\b(?:dossier\\s+m[ée]dical|certificat\\s+m[ée]dical|compte[\\s-]rendu\\s+(?:d['’]hospitalisation|op[ée]ratoire|d['’]examen)|arr[êe]t\\s+(?:de\\s+)?travail|ordonnance\\s+m[ée]dicale|bilan\\s+sanguin|r[ée]sultats?\\s+d['’]analyses?|medical\\s+record|health\\s+record|patient\\s+file|discharge\\s+summary|lab\\s+results?)\\b"
    },
    {
      "label": "Diagnosis or condition",
      "pattern": "\\b(?:cancer|tumeur|VIH|HIV|s[ée]ropositi\\w+|h[ée]patite|diab[èe]te|diabetes|[ée]pilepsie|scl[ée]rose\\s+en\\s+plaques|d[ée]pression|troubles?\\s+bipolaires?|schizophr[ée]nie|burn[\\s-]?out|addiction|toxicomanie|alcoolisme)\\b"
    },
    {
