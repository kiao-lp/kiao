{
  "category": "infrastructure",
  "label": "Network topology and internal systems",
  "description": "The map of a network — private ranges, internal hostnames, ports, cloud resource ids, database endpoints. None of it is a secret by itself, and all of it is reconnaissance: it tells an attacker what to aim at and shortens the work of the first stage considerably.",
  "criticality": "medium",
  "matchers": [
    {
      "label": "Private IPv4 address",
      "pattern": "\\b(?:10\\.(?:\\d{1,3}\\.){2}\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})\\b",
      "criticality": "high",
      "hint": "An address on somebody's internal network — the shape of it is the leak."
    },
    {
      "label": "IPv4 network range",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\s*/\\s*\\d{1,2}\\b",
      "criticality": "high"
    },
    {
      "label": "IPv4 address",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\b",
      "criticality": "low"
    },
    {
      "label": "IPv6 address",
      "pattern": "\\b(?:[0-9a-fA-F]{1,4}:){5,7}[0-9a-fA-F]{1,4}\\b|\\bfe80::[0-9a-fA-F:]{2,}\\b",
      "criticality": "low"
    },
    {
      "label": "MAC address",
      "pattern": "\\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\b",
      "criticality": "low"
    },
    {
      "label": "Internal hostname",
      "pattern": "\\b[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.(?:internal|intranet|local|localdomain|lan|corp|priv|prod|preprod|dmz)\\b",
      "criticality": "high"
    },
    {
      "label": "Service endpoint with a port",
      "pattern": "\\b(?:[a-z0-9-]+\\.)*[a-z0-9-]+:(?:22|23|25|53|389|445|636|1433|1521|3306|3389|5432|5900|6379|8080|8443|9200|27017)\\b|\\b(?:\\d{1,3}\\.){3}\\d{1,3}:\\d{2,5}\\b",
      "criticality": "high"
    },
    {
      "label": "Database or broker connection string",
      "pattern": "\\b(?:jdbc:[a-z0-9]+:|(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|amqp|kafka|ldaps?|ftps?|smb):\\/\\/)\\S{4,}",
      "criticality": "high"
    },
    {
      "label": "Cloud resource identifier",
      "pattern": "\\barn:aws:[a-z0-9-]+:[a-z0-9-]*:\\d{12}:\\S*|\\b(?:i|vpc|subnet|sg|vol|ami|eni|rtb|igw)-[0-9a-f]{8,17}\\b|\\b/subscriptions/[0-9a-f-]{36}/resourceGroups/\\S+",
      "criticality": "high"
    },
    {
      "label": "Remote access instruction",
      "pattern": "\\bssh\\s+(?:-\\S+\\s+)*[a-z0-9._-]+@[a-z0-9.-]+\\b|\\b(?:VPN|IPsec|OpenVPN|WireGuard|RDP|bastion|jump\\s+host|saut\\s+de\\s+rebond)\\b",
      "criticality": "high"
    },
    {
      "label": "Firewall or access rule",
      "pattern": "\\b(?:r[èe]gle\\s+de\\s+pare[\\s-]feu|firewall\\s+rule|iptables|nftables|security\\s+group|network\\s+ACL|liste\\s+blanche\\s+IP|IP\\s+allow[\\s-]?list|port\\s+forwarding|NAT\\s+rule|DMZ)\\b",
      "criticality": "high"
    },
    {
      "label": "Infrastructure inventory",
      "pattern": "\\b(?:sch[ée]ma\\s+r[ée]seau|network\\s+diagram|topologie\\s+r[ée]seau|plan\\s+d['’]adressage|inventaire\\s+des\\s+serveurs|CMDB|architecture\\s+technique\\s+d[ée]taill[ée]e|plan\\s+de\\s+reprise\\s+d['’]activit[ée]|\\bPRA\\b|\\bPCA\\b)\\b",
      "criticality": "high"
    },
    {
      "label": "Known weakness",
      "pattern": "\\bCVE-\\d{4}-\\d{4,7}\\b|\\b(?:vuln[ée]rabilit[ée]\\s+non\\s+corrig[ée]e|faille\\s+de\\s+s[ée]curit[ée]|zero[\\s-]day|exploit\\s+PoC|rapport\\s+de\\s+pentest|penetration\\s+test\\s+report|audit\\s+de\\s+s[ée]curit[ée])\\b",
      "criticality": "critical",
      "hint": "An unpatched weakness plus the address to reach it is an attack path, ready to use."
    },
    {
      "label": "Privileged account named",
      "pattern": "\\b(?:administrateur|administrator|\\badmin\\b|\\broot\\b|sudoers|domain\\s+admin|compte\\s+de\\s+service|service\\s+account)\\b[ \\t]*[:=][ \\t]*(?![./~])\\S{2,}",
      "criticality": "high"
    }
  ]
}
