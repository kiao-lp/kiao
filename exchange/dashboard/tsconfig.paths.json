{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "react-advanced-interactions/*": [
                "src/cms-core/lib/react-advanced-interactions/*"
            ],
            "react-advanced-interactions": [
                "src/cms-core/lib/react-advanced-interactions/index.ts"
            ],
            "react-concise/*": [
                "src/cms-core/lib/react-concise.tsx"
            ],
            "react-concise": [
                "src/cms-core/lib/react-concise.tsx"
            ],
            "@cms-core": [
                "src/cms-core/public-api.ts"
            ],
            "@cms-kit/markdown-editor": [
