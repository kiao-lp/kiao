{
  "category": "financial",
  "label": "Bank, payment and tax identifiers",
  "description": "Account and payment data, and the company identifiers that go with it. An IBAN in a document is what invoice fraud is built on: it is not secret in the cryptographic sense, and it is exactly what an attacker rewrites.",
  "criticality": "high",
  "matchers": [
    {
      "label": "IBAN",
      "pattern": "\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]{4}){3,7}(?:\\s?[A-Z0-9]{1,3})?\\b",
      "caseSensitive": true
    },
    {
      "label": "BIC / SWIFT code",
      "pattern": "\\b(?:BIC|SWIFT)\\b[ \\t]*(?:CODE)?[ \\t]*[:=]?\\s*[A-Z]{6}[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
      "criticality": "medium"
    },
    {
      "label": "French bank details (RIB)",
      "pattern": "\\b(?:RIB\\b|relev[ée]\\s+d['’]identit[ée]\\s+bancaire|code\\s+(?:banque|guichet)|num[ée]ro\\s+de\\s+compte|account\\s+number|routing\\s+number|sort\\s+code)\\b"
    },
    {
      "label": "Payment card number",
      "pattern": "\\b(?:4\\d{3}|5[1-5]\\d{2}|2[2-7]\\d{2}|3[47]\\d{2}|6(?:011|5\\d{2}))[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{1,4}\\b",
      "criticality": "critical",
      "hint": "A PAN. Storing one puts the store in PCI-DSS scope."
    },
    {
      "label": "Card verification value or expiry",
      "pattern": "\\b(?:CVV2?|CVC2?|CV2|cryptogramme(?:\\s+visuel)?)\\b[ \\t]*[:=]?[ \\t]*\\d{3,4}\\b|\\b(?:exp(?:iry|iration)?|date\\s+d['’]expiration)\\b[ \\t]*[:=]?[ \\t]*(?:0[1-9]|1[0-2])\\s*/\\s*\\d{2,4}\\b",
      "criticality": "critical"
    },
    {
      "label": "SIREN / SIRET",
      "pattern": "\\b(?:SIRET|SIREN)\\b[ \\t]*[:=]?[ \\t]*(?:\\d{3}\\s?\\d{3}\\s?\\d{3}(?:\\s?\\d{5})?)?",
      "criticality": "low"
    },
    {
      "label": "VAT or tax identifier",
      "pattern": "\\b(?:FR[A-Z0-9]{2}\\d{9}|(?:DE|ES|IT|BE|NL|LU|PT|PL|AT|IE)\\s?\\d{8,12})\\b|\\b(?:TVA\\s+intracommunautaire|num[ée]ro\\s+fiscal|SPI\\b|tax\\s+identification\\s+number|\\bTIN\\b|\\bEIN\\b[ \\t]*:?[ \\t]*\\d{2}-\\d{7})\\b",
      "criticality": "medium"
    },
    {
      "label": "Crypto wallet address",
      "pattern": "\\b(?:bc1[02-9ac-hj-np-z]{11,71}|[13][a-km-zA-HJ-NP-Z1-9]{25,34}|0x[a-fA-F0-9]{40})\\b",
      "criticality": "medium"
    },
    {
      "label": "Unpublished financial results",
      "pattern": "\\b(?:r[ée]sultats?\\s+(?:non\\s+publi[ée]s|pr[ée]liminaires|trimestriels)|chiffre\\s+d['’]affaires\\s+pr[ée]visionnel|budget\\s+pr[ée]visionnel|forecast\\s+\\(?internal\\)?|EBITDA|marge\\s+brute|business\\s+plan|plan\\s+de\\s+tr[ée]sorerie|cap\\s+table)\\b",
      "criticality": "medium",
      "hint": "Inside information about a company, published or not."
    }
  ]
}
