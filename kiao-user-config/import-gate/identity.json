{
  "category": "identity",
  "label": "Direct personal identifiers",
  "description": "What names a living person, or lets one be re-identified: contact details, state identifiers, dates and places of birth, precise location. Ordinary personal data rather than special-category, so the level is high and not critical — but a document full of it is a subject-access request and a breach notification waiting to happen.",
  "criticality": "high",
  "matchers": [
    {
      "label": "French social security number (NIR)",
      "pattern": "\\b[12][\\s.]\\d{2}[\\s.](?:0[1-9]|1[0-2]|20|3[0-9]|4[0-2]|[5-9]\\d)[\\s.](?:2[AB]|\\d{2})[\\s.]\\d{3}[\\s.]\\d{3}(?:[\\s.]?\\d{2})?\\b|\\b[12]\\d{2}(?:0[1-9]|1[0-2]|20|3[0-9]|4[0-2]|[5-9]\\d)(?:2[AB]|\\d{2})\\d{6}\\d{2}\\b|(?:num[ée]ro\\s+de\\s+s[ée]curit[ée]\\s+sociale|s[ée]curit[ée]\\s+sociale|n[°o]\\s*s[ée]cu|\\bNIR\\b)[ \\t]*[:=]?[ \\t]*[12](?:[\\s.]?\\d){12}(?:[\\s.]?\\d{2})?",
      "criticality": "critical",
      "hint": "The NIR is regulated on its own footing: it encodes sex, birth date and birthplace."
    },
    {
      "label": "US social security number",
      "pattern": "\\b(?!000|666|9\\d\\d)\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b",
      "criticality": "critical"
    },
    {
      "label": "Passport or identity card number",
      "pattern": "\\b(?:passeport|passport|carte\\s+nationale\\s+d['’]identit[ée]|\\bCNI\\b|titre\\s+de\\s+s[ée]jour|permis\\s+de\\s+conduire|driver'?s?\\s+licen[cs]e)\\b(?:[ \\t]*(?:n[°o]|number|no\\.?)?[ \\t]*[:=]?\\s*[A-Z0-9]{6,12}\\b)?",
      "criticality": "critical"
    },
    {
      "label": "Email address",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,24}\\b",
      "criticality": "medium"
    },
    {
      "label": "French telephone number",
      "pattern": "\\b(?:(?:\\+|00)33\\s?\\(?0?\\)?\\s?|0)[1-9](?:[\\s.-]?\\d{2}){4}\\b"
    },
    {
      "label": "International telephone number",
      "pattern": "(?:\\+|\\b00)\\d{1,3}[\\s.-]?\\d{1,4}(?:[\\s.-]?\\d{2,4}){2,4}\\b",
      "criticality": "medium"
    },
    {
      "label": "Date of birth",
      "pattern": "\\b(?:n[ée]\\(?e\\)?\\s+le|date\\s+de\\s+naissance|birth\\s?date|date\\s+of\\s+birth|\\bDOB\\b|born\\s+on)\\b[ \\t]*[:=]?[ \\t]*(?:\\d{1,2}[/.\\s-]\\d{1,2}[/.\\s-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2})?"
    },
    {
      "label": "Place of birth or family name",
      "pattern": "\\b(?:lieu\\s+de\\s+naissance|place\\s+of\\s+birth|nom\\s+de\\s+jeune\\s+fille|nom\\s+de\\s+naissance|maiden\\s+name|filiation|situation\\s+de\\s+famille|marital\\s+status)\\b",
      "criticality": "medium"
    },
    {
      "label": "French postal address",
      "pattern": "\\b\\d{1,4}\\s?(?:bis|ter|quater)?,?\\s+(?:[Rr]ue|[Aa]venue|[Aa]v\\.|[Bb]oulevard|[Bb]d\\.?|[Ii]mpasse|[Aa]ll[ée]e|[Cc]hemin|[Pp]lace|[Rr]oute|[Qq]uai|[Ss]quare|[Vv]illa|[Cc]ours|RUE|AVENUE|BOULEVARD|IMPASSE|CHEMIN|PLACE|ROUTE)\\s+(?:(?:de|du|des|la|le|les|d['’])\\s*){0,3}[A-ZÉÈÀÂÎÔÛ][A-Za-zÀ-ÿ'’-]{1,30}(?:[ -][A-Za-zÀ-ÿ'’-]{1,30}){0,3}",
      "criticality": "medium",
      "caseSensitive": true
    },
    {
      "label": "French postcode and town",
      "pattern": "\\b(?:0[1-9]|[1-8]\\d|9[0-8])\\d{3}\\s+[A-ZÉÈÀÂÎÔÛ][A-Za-zÀ-ÿ'’-]{2,30}(?:[\\s-][A-Za-zÀ-ÿ'’-]{2,30}){0,3}\\b",
      "criticality": "low",
      "caseSensitive": true
    },
    {
      "label": "Precise geolocation",
      "pattern": "\\b-?\\d{1,2}\\.\\d{4,}\\s*,\\s*-?\\d{1,3}\\.\\d{4,}\\b",
      "criticality": "medium"
    },
    {
      "label": "Vehicle registration",
      "pattern": "\\b[A-Z]{2}-\\d{3}-[A-Z]{2}\\b|\\b(?:immatriculation|plaque\\s+d['’]immatriculation|num[ée]ro\\s+VIN|\\bVIN\\b)\\b",
      "criticality": "medium"
    },
    {
      "label": "Personal data notice",
      "pattern": "\\b(?:donn[ée]es?\\s+(?:[àa]\\s+caract[èe]re\\s+)?personnelles?|personal\\s+data|RGPD|\\bGDPR\\b|\\bPII\\b|informations?\\s+nominatives?|anonymis(?:ation|[ée])|pseudonymis(?:ation|[ée]))\\b",
      "criticality": "low",
      "hint": "The document is about personal data, which is a reason to read it rather than a leak on its own."
    }
  ]
}
